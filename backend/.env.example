# SQLite for local dev (default if unset). Swap for a Postgres URL in production,
# e.g. postgresql+psycopg://user:password@host:5432/camp_merch_store
DATABASE_URL=sqlite:///./camp_merch_store.db

# Comma-separated list of origins allowed to call this API from a browser
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Secret used to sign admin login JWTs — set a long random value, never commit the real one
JWT_SECRET_KEY=change-me-to-a-long-random-value
# How long an admin login stays valid, in minutes (720 = 12 hours)
JWT_EXPIRE_MINUTES=720

# Seed admin accounts for `uv run python -m app.seed_admin`, format "email:password,email:password"
ADMIN_SEED_ACCOUNTS=secretary@example.com:change-me

# Local-disk file storage (default when S3_BUCKET below is unset): directory
# uploads are written to, and the base URL they're served back from (this
# API's own origin, since /uploads is mounted here). Fine for local dev only —
# most hosts wipe local disk on every deploy/restart.
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:8000

# Object storage (S3-compatible — Cloudflare R2, AWS S3, etc.) for uploaded
# proof-of-payment screenshots and product photos. Set S3_BUCKET to switch
# from local-disk storage to this in any environment, including local dev.
# S3_BUCKET=camp-merch-uploads
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://<bucket-public-url-or-custom-domain>

# Order confirmation emails: unset SMTP_HOST (the default) just prints the
# email to the console, which is fine for local dev. Set all of these to
# send for real.
NOTIFICATIONS_FROM_EMAIL=no-reply@campmerch.local
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
